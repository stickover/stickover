# URL where your backend API is reachable (Node.js app on Hostinger).
# Example if backend is deployed on the same domain under /api via Node app on port from hPanel:
VITE_API_URL=https://api.stickover.in

# Razorpay public key (safe to expose client-side) - from Razorpay Dashboard -> Settings -> API Keys
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# Google Sign-In client ID for /admin/login (safe to expose client-side)
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID -> Web application
VITE_GOOGLE_CLIENT_ID=631150376971-8ba4btvqsoluk4fljbfkhmjderrk1g5k.apps.googleusercontent.com
