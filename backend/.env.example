# ---- Hostinger MySQL DB details (from hPanel -> Databases -> MySQL Databases) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_stickover
DB_PASSWORD=your_db_password_here
DB_NAME=u123456789_stickover

# ---- Server ----
PORT=5000
NODE_ENV=production

# ---- Admin auth ----
JWT_SECRET=change_this_to_a_long_random_string
ADMIN_EMAIL=admin@stickover.in
ADMIN_PASSWORD=change_this_password

# ---- Google Sign-In (free, from Google Cloud Console -> APIs & Services ->
# Credentials -> OAuth client ID -> Web application) ----
GOOGLE_CLIENT_ID=631150376971-8ba4btvqsoluk4fljbfkhmjderrk1g5k.apps.googleusercontent.com

# ---- CORS: your frontend domain ----
CLIENT_URL=https://stickover.in

# ---- Public URL of THIS backend (used to build absolute og:image URLs
# for WhatsApp/social link-preview cards in routes/share.js) ----
BACKEND_PUBLIC_URL=https://api.stickover.in

# ---- Razorpay (payments) ----
# NOT set here anymore. Razorpay Key ID + Key Secret are entered from the
# Admin Panel -> Settings -> Payment tab after deployment and stored in the
# `payment_credentials` DB table. The site works fine with no Razorpay keys
# at all (checkout will just show "online payment not set up yet") until an
# admin saves them from the dashboard.

# ---- Razorpay webhook (safety net for orders/Purchase event) ----
# Fixes a real problem: when a customer pays via a UPI app (GPay/PhonePe),
# the mobile browser tab can get suspended/reloaded during the app-switch,
# so the site's own success callback never runs — the order (and the Meta
# Purchase pixel event) silently never get recorded even though the
# customer WAS charged. This webhook is Razorpay calling YOUR server
# directly the moment it captures a payment, independent of the customer's
# browser, so it can create the order + fire Purchase reliably either way.
#
# Setup:
#  1. Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook
#  2. Webhook URL: https://api.stickover.in/api/payment/webhook
#  3. Active events: tick "payment.captured"
#  4. Razorpay gives you a Webhook Secret when you save it — paste it below
RAZORPAY_WEBHOOK_SECRET=

# ---- File uploads (served from /uploads, stored on Hostinger disk - no Cloudinary) ----
# CRITICAL: This MUST be an ABSOLUTE path OUTSIDE your app's deployed code
# folder. On Hostinger, every time you re-upload/redeploy your zip, the app
# folder (domains/yourdomain.com/... or wherever your Node app root is) gets
# fully replaced - so anything stored inside it (like a plain "uploads"
# relative folder) gets deleted too. Storing outside that folder means
# redeploys never touch it.
#
# Example (replace u123456789 with your actual Hostinger username, run
# `pwd` in Hostinger Node.js terminal / SSH to confirm your home path):
# UPLOAD_DIR=/home/u123456789/stickover_uploads
UPLOAD_DIR=/home/u123456789/stickover_uploads
MAX_UPLOAD_MB=5
